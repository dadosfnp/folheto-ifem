# Folhetos FNP — configuração local
# Copie para `.env` e ajuste os caminhos da sua máquina.
# O `.env` não é versionado; este arquivo (.env.example) é.

# ---------------------------------------------------------------------------
# FONTE DOS DADOS
# ---------------------------------------------------------------------------
# Pasta das planilhas oficiais que originam TODOS os números dos folhetos.
# É a mesma base que alimenta o banco do IFEM em produção — os folhetos e o
# site saem, portanto, da mesma fonte.
#
# Vive no repositório Subfinanciados (read-only para este projeto).
PLANILHAS_DIR=C:\Users\pedro.ivo\Documents\Projetos-Git\Subfinanciados\base_datas

# Ano de referência dos dados atuais. Precisa bater com o nome da planilha
# `receitas_correntes_<ANO>.xlsx` e com o sufixo das colunas de população
# (`populacao_<AA>`). É o ano impresso nos folhetos.
ANO_REF=2025

# Raiz do Subfinanciados — usada por tools/sync_dados.py quando os dois
# repositórios não estão lado a lado.
SUBFINANCIADOS_DIR=C:\Users\pedro.ivo\Documents\Projetos-Git\Subfinanciados
