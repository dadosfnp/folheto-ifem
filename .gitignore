# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Output — PDFs gerados e lotes arquivados por ano. Nada aqui vai pro git:
# os PDFs são distribuídos por GitHub Releases (ver tools/build_site.py).
output/*.pdf
output/_pdfs_*/
output/_preview_*/
!output/.gitkeep

# Dados de entrada dos municípios (5.4k arquivos, ~94MB por lote).
# Regeneráveis a qualquer momento com `python tools/planilhas_para_json.py`.
# A pasta inteira é ignorada — inclui os lotes de backup por ano, que são
# cópias do mesmo dado e não devem entrar no histórico.
data/ifem/dados-ifem/

# Dados de Risco Climático por município - regeneráveis com
# `python tools/adapta_para_json.py`. O panorama nacional (3 KB) fica versionado
# de propósito: é o único agregado que a página de introdução consome, e exigir
# as planilhas oficiais de quem só quer conferir o layout não se paga.
data/clima/*.json
!data/clima/_panorama_nacional.json

# Harness Claude Code (local)
.claude/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Fontes (binárias — usuário baixa local)
fonts/*.ttf
fonts/*.otf
!fonts/README.md

# Planilhas recuperadas do historico do Subfinanciados (ver adapta_para_json.py)
.cache/
